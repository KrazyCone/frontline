# Copy to .env.local (Firebase console -> Project settings -> Your apps -> Web app config)
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FB_PROJECT_ID=your-project
VITE_FB_APP_ID=
# Shows the Admin panel in Settings. Must match the email in firestore.rules.
VITE_ADMIN_EMAIL=you@gmail.com
