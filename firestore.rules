rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the admin can create/edit/delete manual events and zone overrides.
    // The GitHub Actions fetcher uses the Admin SDK, which bypasses these rules.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'frontline.world.app@gmail.com'; // <- your Google email
    }

    // Any signed-in Google user can read everything. To make the app public, use `allow read: if true;`.
    match /{document=**} {
      allow read: if request.auth != null;
    }
    match /events/{id} { allow write: if isAdmin(); }
    match /zones/{id}  { allow write: if isAdmin(); }
  }
}
